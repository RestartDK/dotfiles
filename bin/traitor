#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: traitor <command> [args...]

Commands:
  re, rebuild [action]   Rebuild current host (default action: switch)
  test                   Rebuild current host with action=test
  rollback               Roll back current host generation
  check                  Run flake checks
  deploy <node> [--dry-run]  Deploy exactly srv-nana or commissioned srv-hatchi
  sync [--expect REV]    Rebase the checkout onto its upstream
  verify srv-hatchi <install-vm|services-vm|closures|policy>  Verify without live access
  update [inputs...]     Update all pins or selected flake inputs
  upgrade                Update everything, then rebuild
  show                   Show flake outputs
  twin                   Apply the Home Manager-only twin profile
  nana                   Rebuild srv-nana explicitly
  mac                    Rebuild dkumlin-macbook-pro explicitly
  work-mac               Rebuild dkumlin-twin-macbook-pro explicitly
  path                   Print resolved dotfiles path
  help                   Show this help

Environment:
  DOTFILES      Override dotfiles checkout path
  DOTFILES_BIN  Used as fallback to find the checkout
  FLAKE_HOST    Override host flake attribute
EOF
}

find_flake_up() {
  local dir
  dir="$(cd "${1:-.}" 2>/dev/null && pwd -P)" || return 1
  while [[ $dir != / ]]; do
    if [[ -f "$dir/flake.nix" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

resolve_flake_dir() {
  local candidates=()
  candidates+=("${FLAKE_DIR:-}")
  candidates+=("$(find_flake_up "$PWD" 2>/dev/null || true)")
  candidates+=("${DOTFILES:-}")
  if [[ -n ${DOTFILES_BIN:-} ]]; then
    candidates+=("$(dirname "$DOTFILES_BIN")")
  fi
  candidates+=("$HOME/.config/dotfiles")

  local candidate
  for candidate in "${candidates[@]}"; do
    [[ -n $candidate ]] || continue
    candidate="${candidate/#\~/$HOME}"
    if [[ -f "$candidate/flake.nix" ]]; then
      cd "$candidate" >/dev/null 2>&1 && pwd -P
      return 0
    fi
  done

  echo "traitor: could not find dotfiles flake" >&2
  exit 1
}

is_darwin() {
  [[ "$(uname -s)" == "Darwin" ]]
}

current_host_attr() {
  if [[ -n ${FLAKE_HOST:-} ]]; then
    printf '%s\n' "$FLAKE_HOST"
    return 0
  fi

  local short
  short="$(hostname -s 2>/dev/null || hostname)"
  case "$short" in
  srv-nana | nana) printf '%s\n' "srv-nana" ;;
  dkumlin-macbook-pro) printf '%s\n' "dkumlin-macbook-pro" ;;
  dkumlin-twin-macbook-pro) printf '%s\n' "dkumlin-twin-macbook-pro" ;;
  *) printf '%s\n' "$short" ;;
  esac
}

sudo_path() {
  local prefix=()
  [[ -d /run/wrappers/bin ]] && prefix+=(/run/wrappers/bin)
  [[ -d /run/current-system/sw/bin ]] && prefix+=(/run/current-system/sw/bin)
  [[ -d /nix/var/nix/profiles/default/bin ]] && prefix+=(/nix/var/nix/profiles/default/bin)
  if ((${#prefix[@]})); then
    local IFS=:
    printf '%s:%s\n' "${prefix[*]}" "$PATH"
  else
    printf '%s\n' "$PATH"
  fi
}

preflight() {
  local flake_dir="$1"
  cd "$flake_dir"

  if [[ -f flake.lock ]]; then
    if grep -nE '^<{7}|^={7}|^>{7}' flake.lock >/tmp/traitor-conflicts.$$ 2>/dev/null; then
      echo "traitor: flake.lock contains conflict markers" >&2
      cat /tmp/traitor-conflicts.$$ >&2
      rm -f /tmp/traitor-conflicts.$$
      exit 1
    fi
    rm -f /tmp/traitor-conflicts.$$
  fi

  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if git grep -nE '^<{7}|^={7}|^>{7}' -- '*.nix' '*.json' '*.jsonc' '*.toml' '*.yml' '*.yaml' '*.md' >/tmp/traitor-conflicts.$$ 2>/dev/null; then
      echo "traitor: tracked files contain conflict markers" >&2
      cat /tmp/traitor-conflicts.$$ >&2
      rm -f /tmp/traitor-conflicts.$$
      exit 1
    fi
    rm -f /tmp/traitor-conflicts.$$
  fi
}

archive_inputs() {
  local flake_dir="$1"
  cd "$flake_dir"
  # Do this before sudo so private inputs can use the user's SSH/1Password agent.
  nix flake archive --no-update-lock-file >/dev/null
}

find_darwin_rebuild() {
  if [[ -x /run/current-system/sw/bin/darwin-rebuild ]]; then
    printf '%s\n' /run/current-system/sw/bin/darwin-rebuild
  elif command -v darwin-rebuild >/dev/null 2>&1; then
    command -v darwin-rebuild
  else
    return 1
  fi
}

run_rebuild() {
  local action="${1:-switch}"
  shift || true
  local flake_dir host
  flake_dir="$(resolve_flake_dir)"
  host="$(current_host_attr)"

  preflight "$flake_dir"
  archive_inputs "$flake_dir"

  if is_darwin; then
    local darwin_rebuild
    if darwin_rebuild="$(find_darwin_rebuild)"; then
      PATH="$(sudo_path)" /usr/bin/sudo "$darwin_rebuild" --flake "$flake_dir#$host" --no-write-lock-file "$action" "$@"
    else
      echo "traitor: darwin-rebuild not found; building it from the flake" >&2
      cd "$flake_dir"
      nix build ".#darwinConfigurations.$host.system"
      PATH="$(sudo_path)" /usr/bin/sudo ./result/sw/bin/darwin-rebuild --flake ".#$host" --no-write-lock-file "$action" "$@"
    fi
  else
    PATH="$(sudo_path)" nixos-rebuild --flake "$flake_dir#$host" --sudo --no-write-lock-file "$action" "$@"
  fi
}

run_rollback() {
  if is_darwin; then
    local darwin_rebuild
    darwin_rebuild="$(find_darwin_rebuild)"
    PATH="$(sudo_path)" /usr/bin/sudo "$darwin_rebuild" --rollback
  else
    PATH="$(sudo_path)" nixos-rebuild --sudo --rollback switch
  fi
}

run_update() {
  local flake_dir
  flake_dir="$(resolve_flake_dir)"
  cd "$flake_dir"

  if (($#)); then
    local input
    for input in "$@"; do
      nix flake update "$input"
    done
  else
    nix flake update
    nix run .#update-pi-packages
  fi
}

run_deploy() {
  if (($# < 1 || $# > 2)) || [[ ${2:-} != "" && ${2:-} != --dry-run ]]; then
    echo "traitor: deploy requires one exact node and optional --dry-run" >&2
    return 2
  fi
  case "$1" in
  srv-nana | srv-hatchi) ;;
  *)
    echo "traitor: unsupported deployment node" >&2
    return 2
    ;;
  esac
  local node="$1" flake_dir state
  flake_dir="$(resolve_flake_dir)"
  preflight "$flake_dir"
  if [[ $node == srv-hatchi ]]; then
    state="$(nix eval --raw "$flake_dir#hatchiCommissioning.state")"
    if [[ $state != physical ]]; then
      echo "traitor: srv-hatchi is uncommissioned; deployment denied" >&2
      return 1
    fi
  fi
  local flags=()
  [[ ${2:-} == --dry-run ]] && flags+=(--dry-activate)
  nix run --inputs-from "$flake_dir" deploy-rs -- "$flake_dir#$node" "${flags[@]}"
}

run_sync() (
  local expected=""
  if (($#)); then
    if (($# != 2)) || [[ $1 != --expect ]]; then
      echo "traitor: sync accepts only optional --expect REV" >&2
      return 2
    fi
    expected=$2
  fi

  local repo branch upstream remote old_head target common_dir lock_path lock_owner
  repo="$(resolve_flake_dir)"
  cd "$repo"
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "traitor: sync requires a Git checkout" >&2
    return 1
  }
  branch="$(git symbolic-ref --quiet --short HEAD)" || {
    echo "traitor: sync refuses a detached HEAD" >&2
    return 1
  }
  upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" || {
    echo "traitor: branch '$branch' has no upstream" >&2
    return 1
  }
  remote=${upstream%%/*}
  if [[ $remote == "$upstream" ]]; then
    echo "traitor: upstream '$upstream' is not a remote branch" >&2
    return 1
  fi

  common_dir="$(git rev-parse --git-common-dir)"
  [[ $common_dir == /* ]] || common_dir="$repo/$common_dir"
  lock_path="$common_dir/traitor-sync.lock"
  if ! ln -s "$$" "$lock_path" 2>/dev/null; then
    lock_owner="$(readlink "$lock_path" 2>/dev/null || true)"
    if [[ $lock_owner =~ ^[0-9]+$ ]] && kill -0 "$lock_owner" 2>/dev/null; then
      echo "traitor: another sync is already running" >&2
      return 1
    fi
    rm -f "$lock_path"
    if ! ln -s "$$" "$lock_path" 2>/dev/null; then
      echo "traitor: another sync acquired the lock" >&2
      return 1
    fi
  fi

  local candidate_dir="" stash_ref="" stash_oid="" stash_pending=false
  restore_stash() {
    [[ $stash_pending == true ]] || return 0
    stash_pending=false
    local stash_target=${stash_oid:-$stash_ref}
    if ! git stash apply --index "$stash_target" >/dev/null; then
      echo "traitor: local changes remain in stash $stash_target" >&2
      return 1
    fi
    if [[ -n $stash_oid && $(git rev-parse "$stash_ref" 2>/dev/null || true) == "$stash_oid" ]]; then
      git stash drop "$stash_ref" >/dev/null
    else
      echo "traitor: restored local changes; retained stash $stash_target" >&2
    fi
  }
  cleanup_sync() {
    restore_stash || true
    if [[ -n $candidate_dir ]]; then
      git worktree remove --force "$candidate_dir" >/dev/null 2>&1 || true
    fi
    if [[ $(readlink "$lock_path" 2>/dev/null || true) == "$$" ]]; then
      rm -f "$lock_path"
    fi
  }
  trap cleanup_sync EXIT

  if [[ -n $(git diff --name-only --diff-filter=U) ]]; then
    echo "traitor: resolve the existing Git conflict before syncing" >&2
    return 1
  fi
  if ! git fetch --prune "$remote"; then
    echo "traitor: could not fetch '$remote'; checkout unchanged" >&2
    return 1
  fi

  old_head="$(git rev-parse HEAD)"
  target="$(git rev-parse "$upstream^{commit}")"
  if [[ -n $expected ]]; then
    local expected_commit
    expected_commit="$(git rev-parse --verify "$expected^{commit}" 2>/dev/null)" || {
      echo "traitor: expected revision '$expected' is unavailable" >&2
      return 1
    }
    if [[ $target != "$expected_commit" ]]; then
      echo "traitor: upstream '$upstream' is at $target, expected $expected_commit" >&2
      return 1
    fi
  fi

  if git merge-base --is-ancestor "$target" "$old_head"; then
    echo "traitor: '$branch' is already up to date with '$upstream'"
    return 0
  fi

  if [[ -n $(git status --porcelain --untracked-files=all) ]]; then
    git stash push --include-untracked --message "traitor sync $old_head" >/dev/null
    stash_ref='stash@{0}'
    stash_pending=true
    stash_oid="$(git rev-parse "$stash_ref")"
  fi

  candidate_dir="$(mktemp -d "${TMPDIR:-/tmp}/traitor-sync.XXXXXX")"
  rmdir "$candidate_dir"
  git worktree add --quiet --detach "$candidate_dir" "$old_head"
  if ! git -C "$candidate_dir" rebase "$target" >/dev/null 2>&1; then
    git -C "$candidate_dir" rebase --abort >/dev/null 2>&1 || true
    restore_stash
    echo "traitor: '$branch' conflicts with '$upstream'; checkout unchanged" >&2
    return 1
  fi
  if [[ -n $stash_oid ]] && ! git -C "$candidate_dir" stash apply --index "$stash_oid" >/dev/null 2>&1; then
    restore_stash
    echo "traitor: local changes conflict with '$upstream'; checkout unchanged" >&2
    return 1
  fi
  git worktree remove --force "$candidate_dir" >/dev/null
  candidate_dir=""

  if ! git rebase "$target"; then
    git rebase --abort >/dev/null 2>&1 || true
    restore_stash
    echo "traitor: rebase failed after its conflict check; checkout restored" >&2
    return 1
  fi
  restore_stash
  cleanup_sync
  echo "traitor: synchronized '$branch' with '$upstream'"
)

run_verify() {
  if (($# != 2)) || [[ $1 != srv-hatchi ]]; then
    echo "traitor: verify requires srv-hatchi and one verification kind" >&2
    return 2
  fi
  case "$2" in
  install-vm | services-vm | closures | policy) ;;
  *)
    echo "traitor: unsupported verification kind" >&2
    return 2
    ;;
  esac
  local flake_dir
  flake_dir="$(resolve_flake_dir)"
  preflight "$flake_dir"
  case "$2" in
  install-vm)
    nix run "$flake_dir#srv-hatchi-install-vm"
    ;;
  services-vm)
    nix build --no-link --print-build-logs "$flake_dir#checks.x86_64-linux.srv-hatchi-services"
    ;;
  closures)
    nix build --no-link --print-build-logs "$flake_dir#nixosConfigurations.srv-hatchi-bootstrap.config.system.build.toplevel" "$flake_dir#nixosConfigurations.srv-hatchi.config.system.build.toplevel"
    ;;
  policy)
    nix build --no-link --print-build-logs "$flake_dir#checks.$(nix eval --impure --raw --expr builtins.currentSystem).srv-hatchi-policy"
    ;;
  esac
}

cmd="${1:-help}"
shift || true

case "$cmd" in
help | -h | --help)
  usage
  ;;
path)
  resolve_flake_dir
  ;;
re | rebuild)
  run_rebuild "${1:-switch}" "${@:2}"
  ;;
test)
  run_rebuild test "$@"
  ;;
rollback)
  run_rollback
  ;;
check)
  flake_dir="$(resolve_flake_dir)"
  cd "$flake_dir"
  nix flake check "$@"
  ;;
deploy)
  run_deploy "$@"
  ;;
sync)
  run_sync "$@"
  ;;
verify)
  run_verify "$@"
  ;;
update)
  run_update "$@"
  ;;
upgrade)
  run_update
  run_rebuild switch
  ;;
show)
  flake_dir="$(resolve_flake_dir)"
  cd "$flake_dir"
  nix flake show
  ;;
twin)
  flake_dir="$(resolve_flake_dir)"
  cd "$flake_dir"
  nix run github:nix-community/home-manager/release-26.05 -- switch --flake "$flake_dir#twin" -b hm-backup "$@"
  ;;
nana)
  FLAKE_HOST=srv-nana run_rebuild switch "$@"
  ;;
mac)
  FLAKE_HOST=dkumlin-macbook-pro run_rebuild switch "$@"
  ;;
work-mac)
  FLAKE_HOST=dkumlin-twin-macbook-pro run_rebuild switch "$@"
  ;;
*)
  echo "traitor: unknown command: $cmd" >&2
  echo >&2
  usage >&2
  exit 2
  ;;
esac
