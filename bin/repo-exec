#!/bin/sh
set -eu

if [ "$#" -eq 0 ]; then
	printf 'Usage: repo-exec COMMAND [ARG...]\n' >&2
	exit 64
fi

shell="${SHELL:-}"
case "${shell##*/}" in
zsh | bash) ;;
*)
	printf 'repo-exec: unsupported shell %s; configure zsh or bash with repo_env_prepare\n' "${SHELL:-unset}" >&2
	exit 69
	;;
esac

exec 3>&1 4<&0
# shellcheck disable=SC2016
exec "$shell" -ic '
  if ! command -v repo_env_prepare >/dev/null 2>&1; then
    printf "repo-exec: shell must define repo_env_prepare before launching commands\n" >&2
    exit 69
  fi
  repo_env_prepare
  result=$?
  if [ "$result" -ne 0 ]; then exit "$result"; fi
  exec 1>&3 3>&- 0<&4 4<&-
  exec "$@"
' repo-exec "$@" 1>&2 </dev/null
