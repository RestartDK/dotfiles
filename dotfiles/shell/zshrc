# Portable shell setup for macOS/Linux. Keep secrets out of this file.

# ---- PATH helpers ---------------------------------------------------------
path_prepend() {
  [[ -d "$1" ]] || return 0
  case ":$PATH:" in
    *":$1:"*) ;;
    *) export PATH="$1:$PATH" ;;
  esac
}

path_append() {
  [[ -d "$1" ]] || return 0
  case ":$PATH:" in
    *":$1:"*) ;;
    *) export PATH="$PATH:$1" ;;
  esac
}

path_remove() {
  [[ -n "$1" ]] || return 0
  local entry
  local -a next_path
  next_path=()
  for entry in "${path[@]}"; do
    [[ "$entry" == "$1" ]] || next_path+=("$entry")
  done
  path=("${next_path[@]}")
  export PATH
}

source_first_existing() {
  local file
  for file in "$@"; do
    [[ -r "$file" ]] || continue
    source "$file"
    return 0
  done
  return 1
}

# Drop stale standalone Home Manager profile from older setups. This profile can
# shadow the NixOS-managed Home Manager packages in /etc/profiles/per-user.
path_remove "$HOME/.local/state/nix/profiles/home-manager/home-path/bin"

# Nix profiles: NixOS/nix-darwin managed user profile first, then legacy user/system profiles.
path_prepend "/run/current-system/sw/bin"
path_prepend "$HOME/.nix-profile/bin"
path_prepend "/etc/profiles/per-user/$USER/bin"

# Homebrew: Apple Silicon macOS default, then whatever `brew --prefix` reports.
path_prepend "/opt/homebrew/bin"
if command -v brew >/dev/null 2>&1; then
  HOMEBREW_PREFIX="$(brew --prefix)"

  path_prepend "$HOMEBREW_PREFIX/bin"

  # PostgreSQL 16
  if [[ -d "$HOMEBREW_PREFIX/opt/postgresql@16" ]]; then
    path_prepend "$HOMEBREW_PREFIX/opt/postgresql@16/bin"
    export LDFLAGS="-L$HOMEBREW_PREFIX/opt/postgresql@16/lib${LDFLAGS:+ $LDFLAGS}"
    export CPPFLAGS="-I$HOMEBREW_PREFIX/opt/postgresql@16/include${CPPFLAGS:+ $CPPFLAGS}"
    export PKG_CONFIG_PATH="$HOMEBREW_PREFIX/opt/postgresql@16/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
  fi

  # LLVM / OpenMP
  if [[ -d "$HOMEBREW_PREFIX/opt/llvm" ]]; then
    path_prepend "$HOMEBREW_PREFIX/opt/llvm/bin"
    export LDFLAGS="-L$HOMEBREW_PREFIX/opt/llvm/lib${LDFLAGS:+ $LDFLAGS}"
    export CPPFLAGS="-I$HOMEBREW_PREFIX/opt/llvm/include${CPPFLAGS:+ $CPPFLAGS}"
  fi

  # Go installed by Homebrew
  if brew --prefix go >/dev/null 2>&1; then
    export GOROOT="$(brew --prefix go)/libexec"
  fi

  path_prepend "$HOMEBREW_PREFIX/opt/openjdk/bin"
fi

# Superset installs agent wrapper binaries in ~/.superset/bin.
# Do not prepend it to PATH globally, because it shadows the real CLIs
# such as codex/claude. Invoke those wrappers explicitly if needed.
# path_prepend "$HOME/.superset/bin"

# User-local tools
path_append "$HOME/.lmstudio/bin"
path_append "$HOME/.local/bin"
path_append "$HOME/.pi/agent/bin"
path_prepend "$HOME/.rbenv/bin"
path_prepend "$HOME/.bun/bin"
path_prepend "$HOME/railpack/bin"
path_append "$HOME/.pub-cache/bin"
path_append "$HOME/.kluster/cli/bin"

[[ -r "$HOME/.config/herdr/netns-hook.zsh" ]] && source "$HOME/.config/herdr/netns-hook.zsh"

# Flutter: common Homebrew cask location on this machine.
path_append "/opt/homebrew/Caskroom/flutter/3.32.4/flutter/bin"

# Go workspace
export GOPATH="$HOME/go"
path_prepend "$GOPATH/bin"
[[ -n "${GOROOT:-}" ]] && path_prepend "$GOROOT/bin"

# fnm config
export FNM_VERSION_FILE_STRATEGY="local"
export FNM_DIR="$HOME/.local/share/fnm"
export FNM_LOGLEVEL="info"
export FNM_NODE_DIST_MIRROR="https://nodejs.org/dist"
export FNM_COREPACK_ENABLED="false"
export FNM_RESOLVE_ENGINES="true"
case "$(uname -m)" in
  arm64|aarch64) export FNM_ARCH="arm64" ;;
  x86_64|amd64) export FNM_ARCH="x64" ;;
esac

# editor config
if command -v cursor >/dev/null 2>&1; then
  export EDITOR="cursor -w"
  export VISUAL="cursor -w"
elif command -v nvim >/dev/null 2>&1; then
  export EDITOR="nvim"
  export VISUAL="nvim"
fi

# Android SDK, if present
if [[ -d "$HOME/Library/Android/sdk" ]]; then
  export JAVA_HOME="/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home"
  export ANDROID_HOME="$HOME/Library/Android/sdk"
  path_append "$ANDROID_HOME/emulator"
  path_append "$ANDROID_HOME/platform-tools"
fi

# history setup
HISTFILE="$HOME/.zhistory"
SAVEHIST=1000
HISTSIZE=999
setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify

# Interactive zsh plugins. Chezmoi fetches user-local copies, and we also
# support Homebrew/Linux package paths when present. Only load visual/ZLE
# plugins when attached to a real terminal.
if [[ -t 0 && -t 1 ]]; then
  source_first_existing \
    "$HOME/.local/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    "$HOME/.nix-profile/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    "/etc/profiles/per-user/$USER/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    "/run/current-system/sw/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    "${HOMEBREW_PREFIX:-}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    "/usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    "/usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"

  source_first_existing \
    "$HOME/.local/share/zsh/plugins/zsh-vi-mode/zsh-vi-mode.plugin.zsh" \
    "$HOME/.nix-profile/share/zsh-vi-mode/zsh-vi-mode.plugin.zsh" \
    "/etc/profiles/per-user/$USER/share/zsh-vi-mode/zsh-vi-mode.plugin.zsh" \
    "/run/current-system/sw/share/zsh-vi-mode/zsh-vi-mode.plugin.zsh" \
    "${HOMEBREW_PREFIX:-}/opt/zsh-vi-mode/share/zsh-vi-mode/zsh-vi-mode.plugin.zsh" \
    "/usr/share/zsh-vi-mode/zsh-vi-mode.plugin.zsh" \
    "/usr/share/zsh/plugins/zsh-vi-mode/zsh-vi-mode.plugin.zsh"
fi

# fzf config
if [[ -t 0 && -t 1 ]]; then
  command -v fzf >/dev/null 2>&1 && source <(fzf --zsh)
fi

# Aliases
command -v eza >/dev/null 2>&1 && alias ls="eza --icons=always"

# Pi's powerline extension cannot reliably detect local Nerd Font support over
# SSH/dev namespaces, because terminal-specific env vars often are not forwarded.
# Default to Nerd Font icons while allowing POWERLINE_NERD_FONTS=0 to override.
export POWERLINE_NERD_FONTS="${POWERLINE_NERD_FONTS:-1}"

# Tool initializers
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"
command -v fnm >/dev/null 2>&1 && eval "$(fnm env --use-on-cd --shell zsh)"
command -v rbenv >/dev/null 2>&1 && eval "$(rbenv init -)"
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
command -v thefuck >/dev/null 2>&1 && eval "$(thefuck --alias)"

# Completions for poetry
[[ -d "$HOME/.zfunc" ]] && fpath+=("$HOME/.zfunc")
autoload -Uz compinit && compinit

# Dart completion
[[ -f "$HOME/.dart-cli-completion/zsh-config.zsh" ]] && source "$HOME/.dart-cli-completion/zsh-config.zsh"

# pnpm
if [[ -d "$HOME/Library/pnpm" ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
  path_prepend "$PNPM_HOME"
elif [[ -d "$HOME/.local/share/pnpm" ]]; then
  export PNPM_HOME="$HOME/.local/share/pnpm"
  path_prepend "$PNPM_HOME"
fi

# bun completions
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

# kluster.ai CLI
command -v kluster >/dev/null 2>&1 && source <(kluster completion zsh)

# >>> pi revive wrapper >>>
# Lets the /revive Pi extension switch profiles in the same terminal.
__pi_revive_run() {
  local cmd="$1"
  shift
  local revive_file="$HOME/.pi/agent/revive.zsh"

  while true; do
    case "$cmd" in
      pi)
        command env -u PI_CODING_AGENT_DIR pi "$@"
        ;;
      *)
        command "$cmd" "$@"
        ;;
    esac

    if [[ ! -f "$revive_file" ]]; then
      return
    fi

    local PI_REVIVE_COMMAND=""
    local PI_REVIVE_AGENT_DIR=""
    local PI_REVIVE_SESSION=""
    local PI_REVIVE_CWD=""
    source "$revive_file"
    rm -f "$revive_file"

    if [[ -z "$PI_REVIVE_COMMAND" || -z "$PI_REVIVE_SESSION" ]]; then
      echo "Invalid Pi revive request: $revive_file" >&2
      return 1
    fi

    if [[ -n "$PI_REVIVE_CWD" ]]; then
      cd "$PI_REVIVE_CWD" || return
    fi

    cmd="$PI_REVIVE_COMMAND"
    case "$PI_REVIVE_AGENT_DIR" in
      "$HOME/.pi/agent"|"")
        export PI_CODING_AGENT_DIR=""
        unset PI_CODING_AGENT_DIR
        ;;
      *)
        export PI_CODING_AGENT_DIR="$PI_REVIVE_AGENT_DIR"
        ;;
    esac
    set -- --session "$PI_REVIVE_SESSION"
  done
}

pi() { __pi_revive_run pi "$@"; }
# <<< pi revive wrapper <<<

# Sentry completions
[[ -d "$HOME/.local/share/zsh/site-functions" ]] && fpath=("$HOME/.local/share/zsh/site-functions" $fpath)

# zsh-syntax-highlighting should be sourced near the end so it can wrap all
# widgets created by plugins and completions above.
if [[ -t 0 && -t 1 ]]; then
  source_first_existing \
    "$HOME/.local/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
    "$HOME/.nix-profile/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
    "/etc/profiles/per-user/$USER/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
    "/run/current-system/sw/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
    "${HOMEBREW_PREFIX:-}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
    "/usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
    "/usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
