#!/usr/bin/env python3
"""Create a Herdr Git worktree, then run project-local .herdr/setup.json commands.

The wrapper intentionally keeps Herdr as the source of truth for worktree creation.
It calls `herdr worktree create --json`, parses the created worktree path, and
then executes setup commands from the source repository's .herdr/setup.json.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any


def eprint(*args: object) -> None:
    print(*args, file=sys.stderr)


def absolutize(path: str, base: Path) -> str:
    p = Path(path).expanduser()
    if not p.is_absolute():
        p = base / p
    return str(p.resolve())


def option_value(args: list[str], name: str) -> str | None:
    for i, arg in enumerate(args):
        if arg == name and i + 1 < len(args):
            return args[i + 1]
        if arg.startswith(name + "="):
            return arg.split("=", 1)[1]
    return None


def current_branch(cwd: Path) -> str | None:
    result = subprocess.run(
        ["git", "branch", "--show-current"],
        cwd=str(cwd),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if result.returncode != 0:
        return None
    branch = result.stdout.strip()
    return branch or None


def open_prompt_io() -> tuple[Any, Any, bool] | None:
    """Return input, output, should_close for an interactive prompt.

    Herdr custom command panes may not wire the process stdin as a TTY even
    though the pane itself has a controlling terminal. Prefer normal
    stdin/stdout when they are interactive, otherwise fall back to /dev/tty.
    """
    if sys.stdin.isatty() and sys.stdout.isatty():
        return sys.stdin, sys.stdout, False
    try:
        tty = open("/dev/tty", "r+", buffering=1)
    except OSError:
        return None
    return tty, tty, True


def prompt_with_default(label: str, default: str | None, prompt_in: Any, prompt_out: Any) -> str:
    suffix = f" [{default}]" if default else ""
    print(f"{label}{suffix}: ", end="", file=prompt_out, flush=True)
    value = prompt_in.readline()
    if value == "":
        raise EOFError
    return value.strip() or (default or "")


def prompt_for_missing_create_args(args: list[str], source_cwd: Path) -> list[str] | None:
    if option_value(args, "--branch") or option_value(args, "--path"):
        return args

    prompt_io = open_prompt_io()
    if prompt_io is None:
        return args
    prompt_in, prompt_out, should_close = prompt_io

    try:
        print("Create Herdr worktree", file=prompt_out, flush=True)
        branch = prompt_with_default("Branch name", None, prompt_in, prompt_out)
        if not branch:
            eprint("herdr-worktree-create: cancelled; branch name is required")
            return None

        base = prompt_with_default("Base ref", "current checkout", prompt_in, prompt_out)
        label = prompt_with_default("Worktree name", branch, prompt_in, prompt_out)
    finally:
        if should_close:
            prompt_in.close()

    next_args = [*args, "--branch", branch]
    if base and base != "current checkout":
        next_args.extend(["--base", base])
    if label:
        next_args.extend(["--label", label])
    return next_args


def git_root(cwd: Path) -> Path | None:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        cwd=str(cwd),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if result.returncode != 0:
        return None
    return Path(result.stdout.strip()).resolve()


def normalize_command(entry: Any, index: int) -> tuple[str, list[str] | str, bool]:
    """Return (label, command, shell)."""
    if isinstance(entry, str):
        return (entry, entry, True)

    if isinstance(entry, list) and all(isinstance(item, str) for item in entry):
        return (" ".join(entry), entry, False)

    if isinstance(entry, dict):
        label = entry.get("name") or entry.get("description") or f"command {index}"
        if isinstance(entry.get("run"), str):
            return (str(label), entry["run"], True)
        if isinstance(entry.get("argv"), list) and all(isinstance(item, str) for item in entry["argv"]):
            return (str(label), entry["argv"], False)

    raise ValueError(
        "commands[%d] must be a shell string, an argv string array, "
        "or an object with {run: string} / {argv: string[]}" % index
    )


def load_setup(source_root: Path) -> tuple[Path | None, list[tuple[str, list[str] | str, bool]]]:
    setup_path = source_root / ".herdr" / "setup.json"
    if not setup_path.exists():
        return None, []

    try:
        payload = json.loads(setup_path.read_text())
    except json.JSONDecodeError as exc:
        raise ValueError(f"{setup_path}: invalid JSON: {exc}") from exc

    if not isinstance(payload, dict):
        raise ValueError(f"{setup_path}: top-level value must be an object")

    raw_commands = payload.get("commands", [])
    if raw_commands is None:
        raw_commands = []
    if not isinstance(raw_commands, list):
        raise ValueError(f"{setup_path}: commands must be an array")

    return setup_path, [normalize_command(entry, i) for i, entry in enumerate(raw_commands)]


def load_script_hooks(source_root: Path) -> list[Path]:
    hooks: list[Path] = []
    for name in ("setup-worktree.sh", "post-worktree-create.sh"):
        path = source_root / ".herdr" / name
        if path.exists() and os.access(path, os.X_OK):
            hooks.append(path)
    return hooks


def parse_herdr_json(stdout: str) -> dict[str, Any]:
    for line in stdout.splitlines():
        stripped = line.strip()
        if stripped.startswith("{"):
            return json.loads(stripped)
    raise ValueError("expected JSON output from herdr worktree create --json")


def main() -> int:
    args = sys.argv[1:]
    if any(arg in ("-h", "--help") for arg in args):
        print(
            "Usage: herdr-worktree-create [herdr worktree create options]\n\n"
            "With --branch or --path, creates a Herdr worktree noninteractively.\n"
            "Without either option in an interactive pane, prompts for branch/base/name.\n"
            "After creation, runs .herdr/setup.json commands and executable shell hooks."
        )
        return 0

    invocation_cwd = Path.cwd()

    source_cwd_arg = option_value(args, "--cwd")
    source_cwd_default = os.environ.get("HERDR_ACTIVE_PANE_CWD") or None
    source_cwd_value = source_cwd_arg or source_cwd_default
    source_cwd = Path(absolutize(source_cwd_value, invocation_cwd)) if source_cwd_value else invocation_cwd
    source_root = git_root(source_cwd)

    setup_path: Path | None = None
    setup_commands: list[tuple[str, list[str] | str, bool]] = []
    script_hooks: list[Path] = []
    if source_root is not None:
        try:
            setup_path, setup_commands = load_setup(source_root)
            script_hooks = load_script_hooks(source_root)
        except ValueError as exc:
            eprint(f"herdr-worktree-create: {exc}")
            return 2

    try:
        prompted_args = prompt_for_missing_create_args(args, source_cwd)
    except (EOFError, KeyboardInterrupt):
        eprint("\nherdr-worktree-create: cancelled")
        return 130
    if prompted_args is None:
        return 130
    args = prompted_args

    herdr_args = ["herdr", "worktree", "create", *args]
    if "--json" not in args:
        herdr_args.append("--json")

    create = subprocess.run(
        herdr_args,
        cwd=str(source_cwd),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if create.stderr:
        sys.stderr.write(create.stderr)
    if create.returncode != 0:
        if create.stdout:
            sys.stdout.write(create.stdout)
        return create.returncode

    try:
        response = parse_herdr_json(create.stdout)
    except Exception as exc:
        if create.stdout:
            sys.stdout.write(create.stdout)
        eprint(f"herdr-worktree-create: {exc}")
        return 2

    result = response.get("result") if isinstance(response, dict) else None
    worktree = result.get("worktree") if isinstance(result, dict) else None
    worktree_path_raw = worktree.get("path") if isinstance(worktree, dict) else None
    has_setup = bool(setup_commands or script_hooks)
    if has_setup and not isinstance(worktree_path_raw, str):
        eprint("herdr-worktree-create: setup exists but Herdr response did not include result.worktree.path")
        return 2

    if has_setup:
        worktree_path = Path(worktree_path_raw).resolve()
        env = os.environ.copy()
        env.update(
            {
                "HERDR_SOURCE_ROOT": str(source_root) if source_root else "",
                "HERDR_SETUP_FILE": str(setup_path) if setup_path else "",
                "HERDR_WORKTREE_PATH": str(worktree_path),
                "HERDR_WORKTREE_BRANCH": str(worktree.get("branch") or "") if isinstance(worktree, dict) else "",
            }
        )

        if setup_path and setup_commands:
            total = len(setup_commands)
            eprint(f"herdr-worktree-create: running {total} setup command(s) from {setup_path}")
            for index, (label, command, shell) in enumerate(setup_commands, start=1):
                eprint(f"herdr-worktree-create: [{index}/{total}] {label}")
                if shell:
                    run = subprocess.run(command, cwd=str(worktree_path), env=env, shell=True, executable="/bin/bash")
                else:
                    run = subprocess.run(command, cwd=str(worktree_path), env=env)
                if run.returncode != 0:
                    eprint(f"herdr-worktree-create: setup command {index} failed with exit code {run.returncode}")
                    return run.returncode

        for hook in script_hooks:
            eprint(f"herdr-worktree-create: running script hook {hook}")
            run = subprocess.run([str(hook)], cwd=str(worktree_path), env=env)
            if run.returncode != 0:
                eprint(f"herdr-worktree-create: script hook {hook} failed with exit code {run.returncode}")
                return run.returncode

    sys.stdout.write(create.stdout)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
