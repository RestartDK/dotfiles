# General config
shell-integration = zsh
desktop-notifications = true
clipboard-read = allow
clipboard-write = allow
cursor-style-blink = false


# Theming config
theme = dark:TokyoNight,light:TokyoNight Day
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true

# Pane/window multiplexing is handled by Herdr, not Ghostty.
# Keep Ctrl-h/j/k/l and Ctrl+Space free for terminal applications.

keybind = super+r=reload_config

window-save-state = always

keybind = command+shift+p=toggle_command_palette
# Removed for Pi/Herdr: this collapses Shift+Enter into legacy bytes.
# Pi can distinguish Shift+Enter when Ghostty forwards the real key event.
# keybind = shift+enter=text:\x1b\r
