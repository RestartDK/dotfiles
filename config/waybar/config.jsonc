{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 8,

  "modules-left": ["custom/nix", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["network", "pulseaudio", "cpu", "memory", "tray"],

  "custom/nix": {
    "format": "",
    "tooltip-format": "NixOS menu",
    "on-click": "$HOME/.config/waybar/scripts/nix-menu"
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "sort-by": "number",
    "format": "{id} {windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "",
    "window-rewrite": {
      "class<com.mitchellh.ghostty>": "",
      "class<kitty>": "",
      "class<Alacritty>": "",
      "class<firefox>": "",
      "class<google-chrome>": "",
      "class<chromium>": "",
      "class<brave-browser>": "󰖟",
      "class<Code>": "󰨞",
      "class<code>": "󰨞",
      "class<VSCodium>": "󰨞",
      "class<Spotify>": "",
      "class<spotify>": "",
      "class<discord>": "",
      "class<vesktop>": "",
      "class<Slack>": "󰒱",
      "class<slack>": "󰒱",
      "class<org.gnome.Nautilus>": "",
      "class<nautilus>": "",
      "class<org.gnome.Settings>": "",
      "class<org.gnome.TextEditor>": "󰈙",
      "class<org.gnome.Calculator>": "",
      "class<org.gnome.Calendar>": "󰃭",
      "class<1Password>": "󰌾",
      "class<steam>": "",
      "class<org.telegram.desktop>": "",
      "class<obsidian>": "󰠮",
      "title<.*btop.*>": ""
    }
  },

  "hyprland/window": {
    "max-length": 80,
    "separate-outputs": true
  },

  "network": {
    "format-wifi": "{essid}",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "offline",
    "tooltip-format": "{ifname}: {ipaddr}"
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "MUTED",
    "scroll-step": 5
  },

  "cpu": {
    "format": "CPU {usage}%"
  },

  "memory": {
    "format": "RAM {}%"
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{:%Y-%m-%d}"
  }
}
