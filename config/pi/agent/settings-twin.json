{
  "defaultModel": "claude-fable-5-1",
  "defaultProvider": "anthropic",
  "defaultThinkingLevel": "xhigh",
  "shellPath": "~/.config/dotfiles/bin/repo-bash",
  "extensions": [
    "-extensions/pi-prompt/index.ts"
  ],
  "fullscreenScrollbar": "auto",
  "hideThinkingBlock": false,
  "lastChangelogVersion": "0.85.1",
  "subagents": {
    "maxParallel": 4,
    "defaultTools": [
      "read",
      "grep",
      "find",
      "ls",
      "bash"
    ]
  },
  "packages": [
    "./packages/pi-mcp-adapter",
    "./packages/pi-web-access"
  ],
  "powerline": {
    "preset": "default",
    "hiddenSegments": [
      "cache_read",
      "cache_write",
      "cost"
    ],
    "customItems": [
      {
        "id": "netns",
        "statusKey": "netns",
        "position": "left",
        "color": "accent"
      }
    ]
  },
  "powerlineWelcome": false,
  "piStartup": {
    "enabled": true,
    "greeting": "hey twin :)"
  },
  "quietStartup": true,
  "skills": [
    "~/.claude/skills"
  ],
  "theme": "Tokyo Night Day/Tokyo Night",
  "tuiMode": "fullscreen"
}