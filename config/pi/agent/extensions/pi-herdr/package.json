{
  "name": "pi-herdr",
  "version": "0.1.0",
  "private": true,
  "description": "Type-safe Herdr orchestration tool for Pi",
  "type": "module",
  "scripts": {
    "generate": "node generate-protocol-types.mjs",
    "check-generated": "node generate-protocol-types.mjs --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@earendil-works/pi-tui": "0.81.1",
    "@types/node": "24.12.0",
    "json-schema-to-typescript": "15.0.4",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
