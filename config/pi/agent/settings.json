{
  "extensions": [
    "-extensions/pi-prompt/index.ts"
  ],
  "fullscreenScrollbar": "auto",
  "hideThinkingBlock": false,
  "lastChangelogVersion": "0.99.1",
  "packages": [
    "./packages/pi-web-access",
    "./packages/pi-claude-task"
  ],
  "powerline": {
    "preset": "default",
    "hiddenSegments": [
      "cache_read",
      "cache_write",
      "cost"
    ],
    "customItems": [
      {
        "id": "netns",
        "statusKey": "netns",
        "position": "left",
        "color": "accent"
      }
    ]
  },
  "powerlineWelcome": false,
  "piStartup": {
    "enabled": true,
    "greeting": "hey dk :)"
  },
  "quietStartup": true,
  "theme": "Tokyo Night Day/Tokyo Night",
  "tuiMode": "fullscreen",
  "enabledModels": [
    "opencode-go/*",
    "openrouter/deepseek/deepseek-v4.1-flash",
    "openrouter/*",
    "openai/*",
    "openai-codex/*",
    "ollama/*"
  ],
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4.1-flash",
  "modelThinkingLevels": {
    "opencode-go/deepseek-v4.1-flash": "high"
  }
}
