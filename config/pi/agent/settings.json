{
  "defaultModel": "gpt-6-astra",
  "defaultProvider": "openai-codex",
  "defaultThinkingLevel": "xhigh",
  "shellPath": "~/.config/dotfiles/bin/repo-bash",
  "extensions": [
    "-extensions/pi-prompt/index.ts"
  ],
  "fullscreenScrollbar": "auto",
  "hideThinkingBlock": false,
  "lastChangelogVersion": "0.80.1",
  "packages": [
    "./packages/pi-mcp-adapter",
    "./packages/pi-web-access"
  ],
  "powerline": {
    "preset": "default",
    "hiddenSegments": [
      "cache_read",
      "cache_write",
      "cost"
    ],
    "customItems": [
      {
        "id": "netns",
        "statusKey": "netns",
        "position": "left",
        "color": "accent"
      }
    ]
  },
  "powerlineWelcome": false,
  "piStartup": {
    "enabled": false,
    "greeting": "hey dk :)"
  },
  "quietStartup": true,
  "skills": [
    "~/.claude/skills"
  ],
  "theme": "Tokyo Night Day/Tokyo Night",
  "tuiMode": "fullscreen"
}
