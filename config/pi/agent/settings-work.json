{
  "extensions": [
    "-extensions/pi-prompt/index.ts"
  ],
  "fullscreenScrollbar": "auto",
  "hideThinkingBlock": false,
  "lastChangelogVersion": "0.99.1",
  "subagents": {
    "maxParallel": 4,
    "defaultTools": [
      "read",
      "grep",
      "find",
      "ls",
      "bash"
    ]
  },
  "packages": [
    "./packages/pi-web-access"
  ],
  "powerline": {
    "preset": "default",
    "hiddenSegments": [
      "cache_read",
      "cache_write",
      "cost"
    ],
    "customItems": [
      {
        "id": "netns",
        "statusKey": "netns",
        "position": "left",
        "color": "accent"
      }
    ]
  },
  "powerlineWelcome": false,
  "piStartup": {
    "enabled": true,
    "greeting": "hey twin :)"
  },
  "quietStartup": true,
  "theme": "Tokyo Night Day/Tokyo Night",
  "tuiMode": "fullscreen",
  "deviceId": "137eae1f-8b8a-477f-a2de-3902c7047899",
  "enabledModels": [
    "openai/gpt-6.1-sol",
    "fireworks/*",
    "openrouter/*",
    "openai/*",
    "anthropic/*",
    "ollama/*"
  ]
}
