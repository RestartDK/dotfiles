{
  "extensions": [
    "-extensions/pi-prompt/index.ts",
    "-extensions/pi-coordination/index.ts"
  ],
  "fullscreenScrollbar": "auto",
  "hideThinkingBlock": false,
  "lastChangelogVersion": "0.99.1",
  "packages": [
    "./packages/pi-web-access",
    "./packages/pi-claude-task"
  ],
  "powerline": {
    "preset": "default",
    "hiddenSegments": [
      "cache_read",
      "cache_write",
      "cost"
    ],
    "customItems": [
      {
        "id": "netns",
        "statusKey": "netns",
        "position": "left",
        "color": "accent"
      }
    ]
  },
  "powerlineWelcome": false,
  "piStartup": {
    "enabled": true,
    "greeting": "hey twin :)"
  },
  "quietStartup": true,
  "theme": "Tokyo Night Day/Tokyo Night",
  "tuiMode": "fullscreen",
  "enabledModels": [
    "openai-codex/gpt-6.1-sol",
    "anthropic/claude-fable-5-1",
    "openai-codex/gpt-6-astra",
    "openrouter/**"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "modelThinkingLevels": {
    "openai-codex/gpt-6.1-sol": "xhigh"
  }
}
