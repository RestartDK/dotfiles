{
  "extensions": [
    "-extensions/pi-prompt/index.ts"
  ],
  "fullscreenScrollbar": "auto",
  "hideThinkingBlock": false,
  "lastChangelogVersion": "0.99.1",
  "packages": [
    "./packages/pi-web-access"
  ],
  "powerline": {
    "preset": "default",
    "hiddenSegments": [
      "cache_read",
      "cache_write",
      "cost"
    ],
    "customItems": [
      {
        "id": "netns",
        "statusKey": "netns",
        "position": "left",
        "color": "accent"
      }
    ]
  },
  "powerlineWelcome": false,
  "piStartup": {
    "enabled": true,
    "greeting": "hey twin :)"
  },
  "quietStartup": true,
  "theme": "Tokyo Night Day/Tokyo Night",
  "tuiMode": "fullscreen",
  "enabledModels": [
    "openai/gpt-6.1-sol",
    "fireworks/*",
    "openrouter/*",
    "openai/*",
    "anthropic/*",
    "ollama/*"
  ]
}
