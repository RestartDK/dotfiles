{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "[ -n \"$CMUX_SURFACE_ID\" ] && [ \"$CMUX_CODEX_HOOKS_DISABLED\" != \"1\" ] && command -v cmux >/dev/null 2>&1 && cmux hooks feed --source codex --event PermissionRequest || echo '{}'",
            "timeout": 120000,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash $HOME/.codex/herdr-agent-state.sh blocked",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "[ -n \"$CMUX_SURFACE_ID\" ] && [ \"$CMUX_CODEX_HOOKS_DISABLED\" != \"1\" ] && command -v cmux >/dev/null 2>&1 && cmux hooks feed --source codex --event PreToolUse || echo '{}'",
            "timeout": 120000,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash $HOME/.codex/herdr-agent-state.sh working",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "[ -n \"$CMUX_SURFACE_ID\" ] && [ \"$CMUX_CODEX_HOOKS_DISABLED\" != \"1\" ] && command -v cmux >/dev/null 2>&1 && cmux hooks codex session-start || echo '{}'",
            "timeout": 5000,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "SUPERSET_AGENT_ID=codex $HOME/.superset/hooks/notify.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash $HOME/.codex/herdr-agent-state.sh idle",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/danielkumlin/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "[ -n \"$CMUX_SURFACE_ID\" ] && [ \"$CMUX_CODEX_HOOKS_DISABLED\" != \"1\" ] && command -v cmux >/dev/null 2>&1 && cmux hooks codex stop || echo '{}'",
            "timeout": 5000,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "SUPERSET_AGENT_ID=codex $HOME/.superset/hooks/notify.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash $HOME/.codex/herdr-agent-state.sh idle",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "[ -n \"$CMUX_SURFACE_ID\" ] && [ \"$CMUX_CODEX_HOOKS_DISABLED\" != \"1\" ] && command -v cmux >/dev/null 2>&1 && cmux hooks codex prompt-submit || echo '{}'",
            "timeout": 5000,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "SUPERSET_AGENT_ID=codex $HOME/.superset/hooks/notify.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash $HOME/.codex/herdr-agent-state.sh working",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "tldraw-offline",
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/danielkumlin/skills/tldraw-offline/inject-server-context.sh' SubagentStart"
          }
        ]
      }
    ]
  }
}
