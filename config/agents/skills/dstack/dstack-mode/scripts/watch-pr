#!/usr/bin/env bash
# Stack-agnostic PR verdict watcher. Reads GitHub state, never mutates anything.
# Verdicts: MERGED | CLOSED | CONFLICT | CI_FAIL | THREADS | HUMAN_PENDING | WAITING | REVIEW | READY
set -euo pipefail

PR="" REPO="" ME="" MODE=drive PRETTY=0 INTERVAL=60
MARKER="Checking with the author before changing anything"
FIXED_PREFIX="Fixed in "

while [ $# -gt 0 ]; do
  case "$1" in
  --repo)
    REPO="$2"
    shift 2
    ;;
  --me)
    ME="$2"
    shift 2
    ;;
  --status-only)
    MODE=status
    shift
    ;;
  --until-closed)
    MODE=closed
    shift
    ;;
  --pretty)
    PRETTY=1
    shift
    ;;
  --interval)
    INTERVAL="$2"
    shift 2
    ;;
  -*)
    echo "unknown flag $1" >&2
    exit 1
    ;;
  *)
    PR="$1"
    shift
    ;;
  esac
done
[ -n "$PR" ] || {
  echo "usage: watch-pr <pr-number> [--repo owner/name] [--status-only | --until-closed] [--pretty] [--interval N] [--me LOGIN]" >&2
  exit 1
}

[ -n "$ME" ] || ME=$(gh api user -q .login)
[ -n "$REPO" ] || REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner)
REPO_ARGS=(--repo "$REPO")
OWNER="${REPO%%/*}" NAME="${REPO##*/}"

snapshot() {
  local view threads
  view=$(gh pr view "$PR" "${REPO_ARGS[@]}" --json state,mergeable,mergeStateStatus,reviewDecision,statusCheckRollup,isDraft)
  threads=$(gh api graphql -f query="
    query(\$owner:String!,\$name:String!,\$pr:Int!){
      repository(owner:\$owner,name:\$name){
        pullRequest(number:\$pr){
          reviewThreads(first:100){nodes{id isResolved isOutdated comments(first:50){nodes{url body createdAt author{login __typename} reactions(first:50){nodes{content createdAt user{login}}}}}}}
        }
      }
    }" -F owner="$OWNER" -F name="$NAME" -F pr="$PR")

  jq -cn --argjson v "$view" --argjson t "$threads" --arg me "$ME" --arg marker "$MARKER" --arg fixed "$FIXED_PREFIX" --arg pr "$PR" --arg repo "$REPO" '
    ($t.errors // []) as $errors
    | if ($errors | length) > 0 then error($errors[0].message) else . end
    | ($v.statusCheckRollup // []) as $checks
    | [$checks[] | select((.conclusion // .state // "") as $c
        | ($c=="FAILURE" or $c=="ERROR" or $c=="TIMED_OUT" or $c=="ACTION_REQUIRED"))] as $failed
    | [$checks[] | select((.status // "") as $s | ($s=="IN_PROGRESS" or $s=="QUEUED" or $s=="PENDING")
        or ((.state // "")=="PENDING"))] as $pending
    | (($t.data.repository.pullRequest.reviewThreads.nodes // [])
       | map(select(.isResolved == false))
       | map(
           . as $thread
           | ($thread.comments.nodes) as $comments
           | ($comments[0]) as $first
           | (if ($first.author.__typename == "Bot") or (($first.author.login // "") | endswith("[bot]"))
              then "bot"
              elif $first.author.login == $me then "owner"
              else "human" end) as $kind
           | (if $kind == "human" then
                ([$comments[] | select(.author.login == $me and (.body | contains($marker)))]
                 | sort_by(.createdAt) | last) as $marked
                | ([$comments[] | (.reactions.nodes // [])[]
                    | select(.user.login == $me and (.content == "THUMBS_UP" or .content == "THUMBS_DOWN"))]
                   | sort_by(.createdAt) | last) as $reaction
                | ([$comments[]
                    | select($marked != null)
                    | select(.author.login == $me
                             and (.body | contains($marker) | not)
                             and (.body | startswith($fixed) | not)
                             and (.createdAt > $marked.createdAt))]
                   | sort_by(.createdAt) | last) as $direction_comment
                | (if $marked == null then {decision:"unanswered"}
                   elif $reaction != null then
                     {decision:(if $reaction.content == "THUMBS_UP" then "implement" else "skip" end)}
                     + (if $direction_comment != null
                        then {direction:($direction_comment.body | gsub("\\s+";" ") | .[0:400])}
                        else {} end)
                   elif $direction_comment != null then
                     {decision:"direction", direction:($direction_comment.body | gsub("\\s+";" ") | .[0:400])}
                   else {decision:"pending"} end)
              else {} end) as $decision
           | {id:$thread.id, kind:$kind, author:$first.author.login, url:$first.url,
              body:(($first.body // "") | gsub("\\s+";" ") | .[0:400])}
             + $decision
         )) as $threads
    | ([$threads[] | select(.kind != "human" or .decision != "pending")]) as $actionable
    | (if $v.state=="MERGED" then "MERGED"
       elif $v.state=="CLOSED" then "CLOSED"
       elif $v.mergeable=="CONFLICTING" then "CONFLICT"
       elif ($failed|length)>0 then "CI_FAIL"
       elif ($actionable|length)>0 then "THREADS"
       elif ($threads|length)>0 then "HUMAN_PENDING"
       elif ($pending|length)>0 then "WAITING"
       elif ($v.reviewDecision=="CHANGES_REQUESTED" or $v.reviewDecision=="REVIEW_REQUIRED") then "REVIEW"
       elif ($v.mergeStateStatus=="CLEAN" or $v.mergeStateStatus=="UNSTABLE" or $v.mergeStateStatus=="HAS_HOOKS") then "READY"
       else "WAITING" end) as $verdict
    | {verdict:$verdict, pr:($pr|tonumber), repo:$repo, draft:$v.isDraft,
       merge_state:$v.mergeStateStatus, review:$v.reviewDecision,
       unresolved_threads:($threads|length),
       human_pending:([$threads[] | select(.kind == "human" and .decision == "pending")]|length),
       failing_checks:[$failed[].name // $failed[].context],
       pending_checks:($pending|length),
       threads:$threads}'
}

emit() {
  if [ "$PRETTY" = 1 ]; then
    echo "$1" | jq -r '"\(.verdict)  PR #\(.pr) \(.repo)  merge=\(.merge_state) review=\(.review) threads=\(.unresolved_threads) pending=\(.pending_checks) failing=\(.failing_checks|join(",")) human_pending=\(.human_pending)", (.threads[] | "  \(.kind) \(.decision // "-") \(.author) \(.url)")'
  else
    echo "$1"
  fi
}

terminal() {
  case "$MODE:$1" in
  *:MERGED | *:CLOSED | drive:CONFLICT | drive:CI_FAIL | drive:THREADS) return 0 ;;
  drive:REVIEW) [ "$2" = CHANGES_REQUESTED ] ;;
  *) return 1 ;;
  esac
}

s=$(snapshot)
emit "$s"
[ "$MODE" = status ] && exit 0
while ! terminal "$(echo "$s" | jq -r .verdict)" "$(echo "$s" | jq -r .review)"; do
  sleep "$INTERVAL"
  s=$(snapshot)
  emit "$s"
done
