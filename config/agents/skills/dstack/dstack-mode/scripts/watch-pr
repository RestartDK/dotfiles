#!/usr/bin/env bash
# Stack-agnostic PR verdict watcher. Reads GitHub state, never mutates anything.
# Verdicts: MERGED | CLOSED | CONFLICT | CI_FAIL | THREADS | HUMAN_PENDING | WAITING | REVIEW | READY
set -euo pipefail

PR="" REPO="" ME="" AGENT_LOGIN="" MODE=drive PRETTY=0 INTERVAL=60 MAX_POLL_FAILURES=10
MARKER="Checking with the author before changing anything"
FIXED_PREFIX="Fixed in "
AGENT_PREFIX="[🫩 Daniel's Agent]"

while [ $# -gt 0 ]; do
	case "$1" in
	--repo)
		REPO="$2"
		shift 2
		;;
	--me)
		ME="$2"
		shift 2
		;;
	--agent-login)
		AGENT_LOGIN="$2"
		shift 2
		;;
	--status-only)
		MODE=status
		shift
		;;
	--until-closed)
		MODE=closed
		shift
		;;
	--pretty)
		PRETTY=1
		shift
		;;
	--interval)
		INTERVAL="$2"
		shift 2
		;;
	-*)
		echo "unknown flag $1" >&2
		exit 1
		;;
	*)
		PR="$1"
		shift
		;;
	esac
done
[ -n "$PR" ] || {
	echo "usage: watch-pr <pr-number> [--repo owner/name] [--status-only | --until-closed] [--pretty] [--interval N] [--me LOGIN] [--agent-login LOGIN]" >&2
	exit 1
}

[ -n "$ME" ] || ME=$(gh api user -q .login)
[ -n "$AGENT_LOGIN" ] || AGENT_LOGIN="$ME"
[ -n "$REPO" ] || REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner)
REPO_ARGS=(--repo "$REPO")
OWNER="${REPO%%/*}" NAME="${REPO##*/}"

snapshot() {
	local view threads
	view=$(gh pr view "$PR" "${REPO_ARGS[@]}" --json state,mergeable,mergeStateStatus,reviewDecision,statusCheckRollup,isDraft)
	threads=$(gh api graphql -f query="
    query(\$owner:String!,\$name:String!,\$pr:Int!){
      repository(owner:\$owner,name:\$name){
        pullRequest(number:\$pr){
          reviewThreads(first:100){pageInfo{hasNextPage} nodes{id isResolved isOutdated comments(first:50){pageInfo{hasNextPage} nodes{id url body createdAt updatedAt author{login __typename} reactions(first:50){pageInfo{hasNextPage} nodes{id content createdAt user{login}}}}}}}
        }
      }
    }" -F owner="$OWNER" -F name="$NAME" -F pr="$PR")

	jq -cn --argjson v "$view" --argjson t "$threads" --arg me "$ME" --arg agent "$AGENT_LOGIN" --arg agent_prefix "$AGENT_PREFIX" --arg marker "$MARKER" --arg fixed "$FIXED_PREFIX" --arg pr "$PR" --arg repo "$REPO" '
    ($t.errors // []) as $errors
    | if ($errors | length) > 0 then error($errors[0].message) else . end
    | ($v.statusCheckRollup // []) as $checks
    | [$checks[] | select((.conclusion // .state // "") as $c
        | ($c=="FAILURE" or $c=="ERROR" or $c=="TIMED_OUT" or $c=="ACTION_REQUIRED"))] as $failed
    | [$checks[] | select((.status // "") as $s | ($s=="IN_PROGRESS" or $s=="QUEUED" or $s=="PENDING")
        or ((.state // "")=="PENDING"))] as $pending
    | ($t.data.repository.pullRequest.reviewThreads) as $connection
    | if $connection.pageInfo.hasNextPage != false
         or any($connection.nodes[]; .comments.pageInfo.hasNextPage != false
           or any(.comments.nodes[]; .reactions.pageInfo.hasNextPage != false))
      then error("Incomplete review observation; pagination requires manual triage") else . end
    | ($connection.nodes
       | map(
           . as $thread
           | ($thread.comments.nodes) as $comments
           | ($comments[0]) as $first
           | (if ($first.author.__typename == "Bot") or (($first.author.login // "") | endswith("[bot]"))
              then "bot"
              elif $first.author.login == $me then "owner"
              else "human" end) as $kind
           | (if $kind == "human" then
                ([$comments[] | select(.author.login == $agent and (.body | contains($marker)))]
                 | sort_by(.createdAt) | last) as $marked
                | (any($comments[]; .author.login != $me
                    and ((.id // .url) == ($first.id // $first.url) or .author.login != $agent or (.body | startswith($agent_prefix) | not))
                    and $marked != null and (.updatedAt // .createdAt) > $marked.createdAt)) as $changed
                | ([$comments[] | . as $comment | (.reactions.nodes // [])[]
                    | select($marked != null and ($comment.id // $comment.url) == ($marked.id // $marked.url) and .createdAt > $marked.createdAt)
                    | select(.user.login == $me and (.content == "THUMBS_UP" or .content == "THUMBS_DOWN"))
                    | . + {target:($comment.id // $comment.url)}]
                   | sort_by(.createdAt) | last) as $reaction
                | ([$comments[]
                    | select($marked != null)
                    | select(.author.login == $me
                             and (.body | contains($marker) | not)
                             and (.body | startswith($fixed) | not)
                             and (.body | startswith($agent_prefix) | not)
                             and ((.updatedAt // .createdAt) > $marked.createdAt))]
                   | sort_by(.updatedAt // .createdAt) | last) as $direction_comment
                | (if $marked == null or $changed then {decision:"unanswered"}
                   elif $direction_comment != null and ($reaction == null or ($direction_comment.updatedAt // $direction_comment.createdAt) > $reaction.createdAt) then
                     {decision:"direction", direction:($direction_comment.body | gsub("\\s+";" ") | .[0:400]),
                      approval:{gate:($marked.id // $marked.url), comment:($direction_comment.id // $direction_comment.url), body:$direction_comment.body, at:($direction_comment.updatedAt // $direction_comment.createdAt)}}
                   elif $reaction != null then
                     {decision:(if $reaction.content == "THUMBS_UP" then "implement" else "skip" end),
                      approval:{gate:($marked.id // $marked.url), reaction:($reaction.id // $reaction.createdAt), content:$reaction.content, target:$reaction.target, at:$reaction.createdAt}}
                     + (if $direction_comment != null
                        then {direction:($direction_comment.body | gsub("\\s+";" ") | .[0:400])}
                        else {} end)
                   else {decision:"pending"} end)
                + {gate_generation:((try ($marked.body | capture("<!-- dstack-generation:(?<fingerprint>[a-f0-9]{32}) -->").fingerprint) catch null) // null)}
              else {} end) as $decision
           | {id:$thread.id, kind:$kind, author:$first.author.login, url:$first.url, resolved:$thread.isResolved,
              body:(($first.body // "") | gsub("\\s+";" ") | .[0:400]),
              discussion:[$comments[] | select((.id // .url) == ($first.id // $first.url) or (.author.login != $me and (.author.login != $agent or (.body | startswith($agent_prefix) | not))))
                | {id:(.id // .url), author:.author.login, body:.body, updatedAt:(.updatedAt // .createdAt)}]}
             + $decision
             + {approval:{vote:($decision.approval // null), author_updates:[$comments[]
                  | select(.author.login == $me and (.author.login != $agent or (.body | startswith($agent_prefix) | not)))
                  | {id:(.id // .url), body:.body, updatedAt:(.updatedAt // .createdAt)}]}}
         )) as $all_threads
    | ([$all_threads[] | select(.resolved == false)]) as $threads
    | ([$threads[] | select(.kind != "human" or .decision != "pending")]) as $actionable
    | (if $v.state=="MERGED" then "MERGED"
       elif $v.state=="CLOSED" then "CLOSED"
       elif $v.mergeable=="CONFLICTING" then "CONFLICT"
       elif ($failed|length)>0 then "CI_FAIL"
       elif ($actionable|length)>0 then "THREADS"
       elif ($threads|length)>0 then "HUMAN_PENDING"
       elif ($pending|length)>0 then "WAITING"
       elif ($v.reviewDecision=="CHANGES_REQUESTED" or $v.reviewDecision=="REVIEW_REQUIRED") then "REVIEW"
       elif ($v.mergeStateStatus=="CLEAN" or $v.mergeStateStatus=="UNSTABLE" or $v.mergeStateStatus=="HAS_HOOKS") then "READY"
       else "WAITING" end) as $verdict
    | {verdict:$verdict, pr:($pr|tonumber), repo:$repo, draft:$v.isDraft,
       merge_state:$v.mergeStateStatus, review:$v.reviewDecision,
       unresolved_threads:($threads|length),
       human_pending:([$threads[] | select(.kind == "human" and .decision == "pending")]|length),
       failing_checks:[$failed[].name // $failed[].context],
       pending_checks:($pending|length),
       complete:true, threads:$threads, resolved_threads:[$all_threads[] | select(.resolved == true)]}'
}

emit() {
	if [ "$PRETTY" = 1 ]; then
		echo "$1" | jq -r '"\(.verdict)  PR #\(.pr) \(.repo)  merge=\(.merge_state) review=\(.review) threads=\(.unresolved_threads) pending=\(.pending_checks) failing=\(.failing_checks|join(",")) human_pending=\(.human_pending)", (.threads[] | "  \(.kind) \(.decision // "-") \(.author) \(.url)")'
	else
		echo "$1"
	fi
}

terminal() {
	case "$MODE:$1" in
	*:MERGED | *:CLOSED | drive:CONFLICT | drive:CI_FAIL | drive:THREADS) return 0 ;;
	drive:REVIEW) [ "$2" = CHANGES_REQUESTED ] ;;
	*) return 1 ;;
	esac
}

failures=0
while :; do
	if ! s=$(snapshot); then
		if [ "$MODE" = status ]; then
			echo "watch-pr: status snapshot failed" >&2
			exit 5
		fi
		failures=$((failures + 1))
		if [ "$failures" -ge "$MAX_POLL_FAILURES" ]; then
			echo "watch-pr: snapshot failed $failures times" >&2
			exit 5
		fi
		sleep "$INTERVAL"
		continue
	fi
	failures=0
	emit "$s"
	[ "$MODE" = status ] && exit 0
	if terminal "$(echo "$s" | jq -r .verdict)" "$(echo "$s" | jq -r .review)"; then
		break
	fi
	sleep "$INTERVAL"
done
