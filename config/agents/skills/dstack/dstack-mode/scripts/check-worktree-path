#!/usr/bin/env python3

import os
from pathlib import Path
import re
import sys

if len(sys.argv) != 2:
    sys.exit("Usage: check-worktree-path <absolute-path>")

path = Path(sys.argv[1])
if not path.is_absolute():
    sys.exit("Worktree path must be absolute.")

if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,12}", path.name):
    sys.exit("Worktree directory name must be 1-13 lowercase ASCII letters, digits, or hyphens, starting with a letter or digit.")

for candidate in (path, path.resolve()):
    length = len(os.fsencode(candidate))
    if length > 60:
        sys.exit(f"Worktree path is {length} bytes; maximum is 60: {candidate}")

print(path)
