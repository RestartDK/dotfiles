+export class RequestAuthorizationError extends Error {
+    constructor(cause) {
+        super(cause instanceof Error ? cause.message : String(cause), { cause });
+        this.name = "RequestAuthorizationError";
+    }
+}
+export function authorizeRequest(options, serializedPayload, model) {
+    try {
+        options?.beforeRequest?.(serializedPayload, model);
+    }
+    catch (cause) {
+        throw new RequestAuthorizationError(cause);
+    }
+}
