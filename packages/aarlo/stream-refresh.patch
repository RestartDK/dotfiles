+    @callback
+    def _async_refresh_stream_source(self) -> None:
+        """Hand the stream worker a fresh URL while the stream lives.
+
+        Arlo's stream URLs are single use. Home Assistant retries the first one
+        until the stream object expires, so a camera that needs waking never
+        recovers and the log fills with failures. Nest and Synology solve the
+        same problem by pushing a new URL into the worker.
+        """
+        if self._stream_refresh_scheduled:
+            return
+        self._stream_refresh_scheduled = True
 
+        async def _refresh(_now=None) -> None:
+            if not self.stream:
+                self._stream_refresh_scheduled = False
+                return
+            try:
+                url = await self.hass.async_add_executor_job(
+                    self._camera.get_stream, "arlo"
+                )
+            except Exception as err:  # noqa: BLE001
+                _LOGGER.debug(f"stream refresh failed for {self._attr_name}: {err}")
+                url = None
+            if url and url != self.stream.source:
+                self.stream.update_source(url)
+            async_call_later(self.hass, STREAM_REFRESH_INTERVAL, _refresh)
+
+        async_call_later(self.hass, STREAM_REFRESH_INTERVAL, _refresh)
