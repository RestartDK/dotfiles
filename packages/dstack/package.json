{
  "name": "dstack-jobs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "dstack": "dist/cli.js",
    "dstackd": "dist/daemon.js"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/cli.ts src/daemon.ts src/server.ts src/worker-guard.ts --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "test": "bun test tests ../../config/pi/agent/extensions/pi-jobs"
  },
  "dependencies": {
    "@earendil-works/pi-durable": "1.1.0",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "typebox": "1.1.12",
    "@types/node": "22.19.15",
    "@types/bun": "1.3.11",
    "typescript": "5.9.3",
    "esbuild": "0.25.12"
  }
}
