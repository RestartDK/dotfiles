+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn durable_command_budget_preserves_workspace_deadlines() {
+        let workspace = Operation::Workspace(DurableHostOperation::Discover);
+        let command = Operation::Command(DurableCommandOperation::Inspect {
+            workspace_id: "coding".to_string(),
+            intent_id: "once".to_string(),
+        });
+        assert_eq!(workspace.rpc_timeout(), Duration::from_secs(2));
+        assert_eq!(
+            workspace.rpc_timeout() + RPC_TIMEOUT,
+            Duration::from_secs(4)
+        );
+        assert_eq!(command.rpc_timeout(), Duration::from_secs(60));
+        assert_eq!(command.rpc_timeout() + RPC_TIMEOUT, Duration::from_secs(62));
+    }
+
+    #[tokio::test]
+    async fn durable_host_frames_are_bounded_and_require_newlines() {
+        let mut exact = vec![b'x'; MAX_FRAME_BYTES];
+        exact.push(b'\n');
+        assert_eq!(
+            read_frame(&mut exact.as_slice()).await.unwrap().len(),
+            MAX_FRAME_BYTES
+        );
+        assert!(read_frame(&mut vec![b'x'; MAX_FRAME_BYTES + 1].as_slice())
+            .await
+            .is_err());
+        assert!(read_frame(&mut b"{}".as_slice()).await.is_err());
+        assert!(read_frame(&mut b"".as_slice()).await.is_err());
+    }
+
+    #[test]
+    fn durable_host_request_size_is_checked_before_io() {
+        let oversized = DurableHostOperation::Submit {
+            workspace_id: "workspace".into(),
+            request_id: "retry".into(),
+            content: "x".repeat(MAX_FRAME_BYTES),
+        };
+        assert!(encode_request("1", &oversized).is_err());
+        let valid = DurableHostOperation::Discover;
+        let frame = encode_request("2", &valid).unwrap();
+        assert_eq!(frame.last(), Some(&b'\n'));
+    }
+
+    #[test]
+    fn durable_host_ready_requires_fixed_identity_version_and_file_tools() {
+        let identity = Identity {
+            deployment_id: "proof".into(),
+            domain: Domain::Work,
+            node_id: "node".into(),
+        };
+        let mut ready = Ready {
+            v: VERSION,
+            kind: "ready".into(),
+            identity: identity.clone(),
+            boot_id: "boot".into(),
+            max_frame_bytes: MAX_FRAME_BYTES,
+            max_in_flight: 1,
+            tools: vec!["read".into(), "write".into(), "edit".into()],
+            command_operations: vec![],
+        };
+        ready.verify(&identity).unwrap();
+        assert!(serde_json::to_value(&ready)
+            .unwrap()
+            .get("commandOperations")
+            .is_none());
+        ready.command_operations = vec!["execution.status".into(), "file.reconcile".into()];
+        ready.verify(&identity).unwrap();
+        ready.command_operations = DURABLE_COMMAND_OPERATIONS
+            .iter()
+            .map(|name| (*name).into())
+            .collect();
+        ready.verify(&identity).unwrap();
+        ready.command_operations.push("command.shell".into());
+        assert!(ready.verify(&identity).is_err());
+        ready.command_operations.clear();
+        ready.identity.domain = Domain::Personal;
+        assert!(ready.verify(&identity).is_err());
+        ready.identity = identity.clone();
+        ready.v = 2;
+        assert!(ready.verify(&identity).is_err());
+        ready.v = VERSION;
+        ready.tools.push("bash".into());
+        assert!(ready.verify(&identity).is_err());
+        assert!(!Guardian::default().enabled());
