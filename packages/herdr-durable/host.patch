+fn api_durable(args: &[String]) -> std::io::Result<i32> {
+    let [operation] = args else {
+        eprintln!("usage: herdr api durable '<operation-json>'");
+        return Ok(2);
+    };
+    if operation.len() > 128 * 1024 {
+        eprintln!("durable operation exceeds byte limit");
+        return Ok(2);
+    }
+    super::print_response(&super::send_request(&Request {
+        id: "cli:api:durable".into(),
+        method: durable_method(operation)?,
+    })?)
+}
+
+fn durable_method(bytes: &str) -> std::io::Result<Method> {
+    let operation: serde_json::Value = serde_json::from_str(bytes)?;
+    let command = operation
+        .get("op")
+        .and_then(serde_json::Value::as_str)
+        .is_some_and(|name| {
+            name.starts_with("command.") || name == "file.reconcile" || name == "execution.status"
+        });
+    Ok(if command {
+        Method::DurableCommands(serde_json::from_value(operation)?)
+    } else {
+        Method::DurableHost(serde_json::from_value(operation)?)
+    })
+}
