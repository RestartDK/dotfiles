+
+    #[tokio::test]
+    async fn durable_host_frames_are_bounded_and_require_newlines() {
+        let mut exact = vec![b'x'; MAX_FRAME_BYTES];
+        exact.push(b'\n');
+        assert_eq!(
+            read_frame(&mut exact.as_slice()).await.unwrap().len(),
+            MAX_FRAME_BYTES
+        );
+        assert!(read_frame(&mut vec![b'x'; MAX_FRAME_BYTES + 1].as_slice())
+            .await
+            .is_err());
+        assert!(read_frame(&mut b"{}".as_slice()).await.is_err());
+        assert!(read_frame(&mut b"".as_slice()).await.is_err());
+    }
+
+    #[test]
+    fn durable_host_request_size_is_checked_before_io() {
+        let oversized = DurableHostOperation::Submit {
+            workspace_id: "workspace".into(),
+            request_id: "retry".into(),
+            content: "x".repeat(MAX_FRAME_BYTES),
+        };
+        assert!(encode_request("1", &oversized).is_err());
+        let valid = DurableHostOperation::Discover;
+        let frame = encode_request("2", &valid).unwrap();
+        assert_eq!(frame.last(), Some(&b'\n'));
+    }
+
+    #[test]
+    fn durable_host_ready_requires_fixed_identity_version_and_file_tools() {
+        let identity = Identity {
+            deployment_id: "proof".into(),
+            domain: Domain::Work,
+            node_id: "node".into(),
+        };
+        let mut ready = Ready {
+            v: VERSION,
+            kind: "ready".into(),
+            identity: identity.clone(),
+            boot_id: "boot".into(),
+            max_frame_bytes: MAX_FRAME_BYTES,
+            max_in_flight: 1,
+            tools: vec!["read".into(), "write".into(), "edit".into()],
+        };
+        ready.verify(&identity).unwrap();
+        ready.identity.domain = Domain::Personal;
+        assert!(ready.verify(&identity).is_err());
+        ready.identity = identity.clone();
+        ready.v = 2;
+        assert!(ready.verify(&identity).is_err());
+        ready.v = VERSION;
+        ready.tools.push("bash".into());
+        assert!(ready.verify(&identity).is_err());
+        assert!(!Guardian::default().enabled());
+    }
