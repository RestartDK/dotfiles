diff --git a/src/api/schema/durable_commands.rs b/src/api/schema/durable_commands.rs
new file mode 100644
index 0000000..6de5f9a
--- /dev/null
+++ b/src/api/schema/durable_commands.rs
@@ -0,0 +1,133 @@
+use serde::{Deserialize, Serialize};
+
+pub const DURABLE_COMMAND_OPERATIONS: [&str; 10] = [
+    "execution.status",
+    "command.authorize",
+    "command.start",
+    "command.status",
+    "command.inspect",
+    "command.adopt",
+    "command.cancel",
+    "command.release",
+    "command.reconcile",
+    "file.reconcile",
+];
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, schemars::JsonSchema)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct DurableCommandSpec {
+    #[schemars(length(min = 1, max = 128))]
+    pub argv: Vec<String>,
+    #[schemars(range(min = 1, max = 3600))]
+    pub timeout_seconds: u32,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, schemars::JsonSchema)]
+#[serde(tag = "kind", deny_unknown_fields)]
+pub enum DurableCommandContainment {
+    #[serde(rename = "manager")]
+    Manager,
+    #[serde(rename = "trusted-offline")]
+    TrustedOffline { reference: String },
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize, schemars::JsonSchema)]
+#[serde(tag = "op", rename_all_fields = "camelCase", deny_unknown_fields)]
+pub enum DurableCommandOperation {
+    #[serde(rename = "execution.status")]
+    ExecutionStatus { workspace_id: String },
+    #[serde(rename = "command.health")]
+    Health,
+    #[serde(rename = "command.authorize")]
+    Authorize {
+        workspace_id: String,
+        intent_id: String,
+        spec: DurableCommandSpec,
+    },
+    #[serde(rename = "command.start")]
+    Start {
+        workspace_id: String,
+        intent_id: String,
+    },
+    #[serde(rename = "command.status")]
+    Status {
+        workspace_id: String,
+        intent_id: String,
+    },
+    #[serde(rename = "command.inspect")]
+    Inspect {
+        workspace_id: String,
+        intent_id: String,
+    },
+    #[serde(rename = "command.adopt")]
+    Adopt {
+        workspace_id: String,
+        intent_id: String,
+    },
+    #[serde(rename = "command.cancel")]
+    Cancel {
+        workspace_id: String,
+        intent_id: String,
+    },
+    #[serde(rename = "command.release")]
+    Release {
+        workspace_id: String,
+        intent_id: String,
+    },
+    #[serde(rename = "command.reconcile")]
+    Reconcile {
+        workspace_id: String,
+        intent_id: String,
+        reference: String,
+        containment: DurableCommandContainment,
+    },
+    #[serde(rename = "file.reconcile")]
+    FileReconcile {
+        workspace_id: String,
+        effect_id: String,
+        reference: String,
+    },
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::api::schema::{DurableHostOperation, Method};
+    use serde_json::json;
+
+    #[test]
+    fn durable_command_method_does_not_widen_the_published_workspace_contract() {
+        let operation = json!({"op":"command.start","workspaceId":"coding","intentId":"build-17"});
+        assert!(serde_json::from_value::<DurableHostOperation>(operation.clone()).is_err());
+        let method = serde_json::from_value::<Method>(
+            json!({"method":"durable.commands.v1","params":operation}),
+        )
+        .unwrap();
+        assert!(matches!(
+            method,
+            Method::DurableCommands(DurableCommandOperation::Start { .. })
+        ));
+    }
+
+    #[test]
+    fn durable_command_schema_rejects_caller_authority_and_start_arguments() {
+        let valid = json!({"op":"command.authorize","workspaceId":"coding","intentId":"build-17","spec":{"argv":["/tool", ""],"timeoutSeconds":60}});
+        assert!(serde_json::from_value::<DurableCommandOperation>(valid.clone()).is_ok());
+        for field in [
+            "actor",
+            "environment",
+            "rootId",
+            "sourceBootId",
+            "approval",
+            "captureEpoch",
+        ] {
+            let mut invalid = valid.clone();
+            invalid[field] = json!("caller-controlled");
+            assert!(serde_json::from_value::<DurableCommandOperation>(invalid).is_err());
+        }
+        let mut nested = valid;
+        nested["spec"]["environment"] = json!({});
+        assert!(serde_json::from_value::<DurableCommandOperation>(nested).is_err());
+        assert!(serde_json::from_value::<DurableCommandOperation>(json!({"op":"command.start","workspaceId":"coding","intentId":"build-17","spec":{"argv":["/tool"],"timeoutSeconds":60}})).is_err());
+    }
+}
