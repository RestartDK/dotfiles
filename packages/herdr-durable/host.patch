+use std::io::{self, Read};
+use std::path::PathBuf;
+use std::process::Stdio;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+use tokio::process::{Child, ChildStdin, ChildStdout, Command};
+use tokio::sync::{mpsc, oneshot};
+use tokio::time::{timeout, Instant};
+
+use crate::api::schema::{
+    DurableCommandOperation, DurableHostOperation, ErrorBody, ErrorResponse, ResponseResult,
+    SuccessResponse, DURABLE_COMMAND_OPERATIONS,
+};
+use crate::api::ApiRequestMessage;
+
+const VERSION: u32 = 1;
+const MAX_FRAME_BYTES: usize = 256 * 1024;
+const QUEUE_CAPACITY: usize = 16;
+const MAX_ATTEMPTS: u32 = 3;
+const RPC_TIMEOUT: Duration = Duration::from_secs(2);
+const COMMAND_RPC_TIMEOUT: Duration = Duration::from_secs(60);
+const SHUTDOWN_TIMEOUT: Duration = Duration::from_secs(10);
+
+#[derive(Debug, Clone, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Identity {
+    deployment_id: String,
+    domain: Domain,
+    node_id: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(rename_all = "lowercase")]
+enum Domain {
+    Work,
+    Personal,
+}
+
+#[derive(Deserialize)]
+struct HostConfig {
+    identity: Identity,
+}
+
+struct BootConfig {
+    path: PathBuf,
+    identity: Identity,
+    sha256: String,
+}
+
+#[derive(Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Ready {
+    v: u32,
+    #[serde(rename = "type")]
+    kind: String,
+    identity: Identity,
+    boot_id: String,
+    max_frame_bytes: usize,
+    max_in_flight: usize,
+    tools: Vec<String>,
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    command_operations: Vec<String>,
+}
+
+impl Ready {
+    fn verify(&self, identity: &Identity) -> io::Result<()> {
+        if self.v != VERSION
+            || self.kind != "ready"
+            || &self.identity != identity
+            || self.boot_id.is_empty()
+            || self.boot_id.len() > 200
+            || self.max_frame_bytes != MAX_FRAME_BYTES
+            || self.max_in_flight != 1
+            || self.tools != ["read", "write", "edit"]
+            || !(self.command_operations.is_empty()
+                || self.command_operations == ["execution.status", "file.reconcile"]
+                || self.command_operations == DURABLE_COMMAND_OPERATIONS)
+        {
+            return Err(io::Error::other("durable host readiness contract mismatch"));
+        }
+        Ok(())
+    }
+}
+
+#[derive(Debug, Serialize)]
+#[serde(tag = "phase", rename_all = "snake_case")]
+enum Status {
+    Disabled,
+    Starting { attempt: u32 },
+    Ready { ready: Ready },
+    Unavailable { attempts: u32, reason: String },
+    Stopped,
+}
+
+#[derive(Serialize)]
+#[serde(untagged)]
+enum Operation {
+    Workspace(DurableHostOperation),
+    Command(DurableCommandOperation),
+}
+
+impl Operation {
+    fn rpc_timeout(&self) -> Duration {
+        match self {
+            Self::Workspace(_) => RPC_TIMEOUT,
+            Self::Command(_) => COMMAND_RPC_TIMEOUT,
+        }
+    }
+}
+
+struct Pending {
+    message: ApiRequestMessage,
+    operation: Operation,
+    deadline: Instant,
+}
+
+pub(crate) struct Guardian {
+    status: Arc<Mutex<Status>>,
+    requests: Option<mpsc::Sender<Pending>>,
+    stop: Option<oneshot::Sender<()>>,
+    thread: Option<std::thread::JoinHandle<()>>,
+}
+
+impl Default for Guardian {
+    fn default() -> Self {
+        Self {
+            status: Arc::new(Mutex::new(Status::Disabled)),
+            requests: None,
+            stop: None,
+            thread: None,
+        }
+    }
+}
+
+fn set_status(status: &Mutex<Status>, value: Status) {
+    match status.lock() {
+        Ok(mut current) => *current = value,
+        Err(error) => *error.into_inner() = value,
+    }
+}
+
+impl Guardian {
+    pub(crate) fn from_environment() -> Self {
+        let Some(config_path) = std::env::var_os("HERDR_DURABLE_HOST_CONFIG") else {
+            return Self::default();
+        };
+        let mut guardian = Self::default();
+        set_status(&guardian.status, Status::Starting { attempt: 1 });
+        let config_path = PathBuf::from(config_path);
+        let loaded = (|| -> io::Result<BootConfig> {
+            if !config_path.is_absolute() {
+                return Err(io::Error::other(
+                    "durable host config path must be absolute",
+                ));
+            }
+            if !std::fs::metadata(&config_path)?.is_file() {
+                return Err(io::Error::other(
+                    "durable host config must be a regular file",
+                ));
+            }
+            let mut bytes = Vec::new();
+            std::fs::File::open(&config_path)?
+                .take(65537)
+                .read_to_end(&mut bytes)?;
+            if bytes.len() > 65536 {
+                return Err(io::Error::other("durable host config is too large"));
+            }
+            let config: HostConfig = serde_json::from_slice(&bytes).map_err(io::Error::other)?;
+            Ok(BootConfig {
+                path: config_path.clone(),
+                identity: config.identity,
+                sha256: format!("{:x}", Sha256::digest(&bytes)),
+            })
+        })();
+        let config = match loaded {
+            Ok(config) => config,
+            Err(error) => {
+                set_status(
+                    &guardian.status,
+                    Status::Unavailable {
+                        attempts: 0,
+                        reason: error.to_string(),
+                    },
+                );
+                return guardian;
+            }
+        };
+        let executable = std::env::var_os("HERDR_DURABLE_HOST_EXECUTABLE")
+            .unwrap_or_else(|| "dstack-host".into());
+        let (requests, receiver) = mpsc::channel(QUEUE_CAPACITY);
+        let (stop, stopped) = oneshot::channel();
+        let status = guardian.status.clone();
+        set_status(&status, Status::Starting { attempt: 1 });
+        let spawned = std::thread::Builder::new()
+            .name("herdr-durable-host".into())
+            .spawn(move || {
+                let runtime = tokio::runtime::Builder::new_current_thread()
+                    .enable_all()
+                    .build();
+                match runtime {
+                    Ok(runtime) => runtime.block_on(supervise(
+                        executable.into(),
+                        config,
+                        status,
+                        receiver,
+                        stopped,
+                    )),
+                    Err(error) => set_status(
+                        &status,
+                        Status::Unavailable {
+                            attempts: 0,
+                            reason: error.to_string(),
+                        },
+                    ),
+                }
+            });
+        match spawned {
+            Ok(thread) => {
+                guardian.requests = Some(requests);
+                guardian.stop = Some(stop);
+                guardian.thread = Some(thread);
+            }
+            Err(error) => set_status(
+                &guardian.status,
+                Status::Unavailable {
+                    attempts: 0,
+                    reason: error.to_string(),
+                },
+            ),
+        }
+        guardian
+    }
+
+    #[cfg(test)]
+    pub(super) fn enabled_for_test() -> Self {
+        let guardian = Self::default();
+        set_status(&guardian.status, Status::Starting { attempt: 1 });
+        guardian
+    }
+
+    pub(crate) fn enabled(&self) -> bool {
+        !matches!(
+            *self
+                .status
+                .lock()
+                .unwrap_or_else(|error| error.into_inner()),
+            Status::Disabled
+        )
+    }
+
+    pub(crate) fn handle(&self, message: ApiRequestMessage, operation: DurableHostOperation) {
+        if matches!(operation, DurableHostOperation::Health) {
+            let status = self
+                .status
+                .lock()
+                .unwrap_or_else(|error| error.into_inner());
+            respond(
+                message,
+                Ok(json!({"status": *status, "method": "durable.host.v1",
+                "operations": if matches!(*status, Status::Ready { .. }) { vec!["create", "discover", "snapshot", "submit", "status"] } else { vec![] },
+                "queueCapacity": QUEUE_CAPACITY})),
+            );
+            return;
+        }
+        self.enqueue(message, Operation::Workspace(operation));
+    }
+
+    pub(crate) fn handle_commands(
+        &self,
+        message: ApiRequestMessage,
+        operation: DurableCommandOperation,
+    ) {
+        let status = self
+            .status
+            .lock()
+            .unwrap_or_else(|error| error.into_inner());
+        let operations = match &*status {
+            Status::Ready { ready } => ready.command_operations.as_slice(),
+            _ => &[],
+        };
+        if matches!(operation, DurableCommandOperation::Health) {
+            respond(
+                message,
+                Ok(json!({
+                    "status": *status, "method": "durable.commands.v1",
+                    "operations": operations, "queueCapacity": QUEUE_CAPACITY,
+                })),
+            );
+            return;
+        }
+        if operations.is_empty() {
+            respond(
+                message,
+                Err(failure(
+                    "durable_commands_unavailable",
+                    "Managed command API is not enabled",
+                )),
+            );
+            return;
+        }
+        drop(status);
+        self.enqueue(message, Operation::Command(operation));
+    }
+
+    fn enqueue(&self, message: ApiRequestMessage, operation: Operation) {
+        let status = self
+            .status
+            .lock()
+            .unwrap_or_else(|error| error.into_inner());
+        let ready = matches!(*status, Status::Ready { .. });
+        if !ready {
+            respond(
+                message,
+                Err(failure(
+                    "durable_host_unavailable",
+                    "Optional durable host is not ready",
+                )),
+            );
+            return;
+        }
+        let Some(requests) = &self.requests else {
+            respond(
+                message,
+                Err(failure(
+                    "durable_host_unavailable",
+                    "Optional durable host is not running",
+                )),
+            );
+            return;
+        };
+        let deadline = Instant::now() + operation.rpc_timeout() + RPC_TIMEOUT;
+        let request = Pending {
+            message,
+            operation,
+            deadline,
+        };
+        if let Err(error) = requests.try_send(request) {
+            let (request, code) = match error {
+                mpsc::error::TrySendError::Full(request) => (request, "durable_host_busy"),
+                mpsc::error::TrySendError::Closed(request) => (request, "durable_host_unavailable"),
+            };
+            respond(
+                request.message,
+                Err(failure(code, "Durable host request was not sent")),
+            );
+        }
+    }
+
+    pub(crate) fn stop(&mut self) {
+        self.requests.take();
+        if let Some(stop) = self.stop.take() {
+            let _ = stop.send(());
+        }
+        if let Some(thread) = self.thread.take() {
+            if thread.join().is_err() {
+                tracing::warn!("durable host guardian panicked");
+            }
+        }
+    }
+}
+
+impl Drop for Guardian {
+    fn drop(&mut self) {
+        self.stop();
+    }
+}
+
+fn failure(code: &str, message: &str) -> ErrorBody {
+    ErrorBody {
+        code: code.into(),
+        message: message.into(),
+    }
+}
+
+fn respond(message: ApiRequestMessage, result: Result<Value, ErrorBody>) {
+    let encoded = match result {
+        Ok(value) => serde_json::to_string(&SuccessResponse {
+            id: message.request.id,
+            result: ResponseResult::DurableHost { value },
+        }),
+        Err(error) => serde_json::to_string(&ErrorResponse {
+            id: message.request.id,
+            error,
+        }),
+    };
+    if let Ok(encoded) = encoded {
+        let _ = message.respond_to.send(encoded);
+    }
+}
+
+fn encode_request(id: &str, operation: &impl Serialize) -> io::Result<Vec<u8>> {
+    let mut frame = serde_json::to_vec(&json!({"v": VERSION, "id": id, "operation": operation}))?;
+    if frame.len() > MAX_FRAME_BYTES {
+        return Err(io::Error::other("host request exceeds byte limit"));
+    }
+    frame.push(b'\n');
+    Ok(frame)
+}
+
+struct Worker {
+    child: Child,
+    input: Option<ChildStdin>,
+    output: BufReader<ChildStdout>,
+}
+
+impl Worker {
+    fn spawn(executable: &PathBuf, config: &BootConfig) -> io::Result<Self> {
+        let mut child = Command::new(executable)
+            .arg(&config.path)
+            .env("HERDR_DURABLE_HOST_CONFIG_SHA256", &config.sha256)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::inherit())
+            .kill_on_drop(true)
+            .spawn()?;
+        let input = child
+            .stdin
+            .take()
+            .ok_or_else(|| io::Error::other("missing host stdin"))?;
+        let output = child
+            .stdout
+            .take()
+            .ok_or_else(|| io::Error::other("missing host stdout"))?;
+        Ok(Self {
+            child,
+            input: Some(input),
+            output: BufReader::new(output),
+        })
+    }
+
+    async fn exchange(&mut self, id: &str, frame: &[u8]) -> io::Result<Result<Value, ErrorBody>> {
+        self.input
+            .as_mut()
+            .ok_or_else(|| io::Error::other("host stdin closed"))?
+            .write_all(frame)
+            .await?;
+        let response: Reply = serde_json::from_slice(&read_frame(&mut self.output).await?)?;
+        match response {
+            Reply::Success {
+                v,
+                id: reply_id,
+                result,
+            } if v == VERSION && reply_id == id => Ok(Ok(result)),
+            Reply::Failure {
+                v,
+                id: reply_id,
+                error,
+            } if v == VERSION && reply_id == id => Ok(Err(error)),
+            _ => Err(io::Error::other(
+                "host response version or request ID mismatch",
+            )),
+        }
+    }
+
+    async fn close(&mut self) {
+        self.input.take();
+        if timeout(SHUTDOWN_TIMEOUT, self.child.wait()).await.is_err() {
+            tracing::warn!("durable host exceeded graceful shutdown deadline; killing and reaping");
+            let _ = self.child.kill().await;
+            let _ = self.child.wait().await;
+        }
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(untagged, deny_unknown_fields)]
+enum Reply {
+    Success {
+        v: u32,
+        id: String,
+        result: Value,
+    },
+    Failure {
+        v: u32,
+        id: String,
+        error: ErrorBody,
+    },
+}
+
+async fn read_frame<R: tokio::io::AsyncBufRead + Unpin>(reader: &mut R) -> io::Result<Vec<u8>> {
+    let mut frame = Vec::new();
+    loop {
+        let bytes = reader.fill_buf().await?;
+        if bytes.is_empty() {
+            return Err(io::Error::new(
+                io::ErrorKind::UnexpectedEof,
+                "host stdout closed",
+            ));
+        }
+        let newline = bytes.iter().position(|byte| *byte == b'\n');
+        let count = newline.unwrap_or(bytes.len());
+        if frame.len() + count > MAX_FRAME_BYTES {
+            return Err(io::Error::other("host frame exceeds byte limit"));
+        }
+        frame.extend_from_slice(&bytes[..count]);
+        reader.consume(count + usize::from(newline.is_some()));
+        if newline.is_some() {
+            return Ok(frame);
+        }
+    }
+}
+
+async fn supervise(
+    executable: PathBuf,
+    config: BootConfig,
+    status: Arc<Mutex<Status>>,
+    mut requests: mpsc::Receiver<Pending>,
+    mut stop: oneshot::Receiver<()>,
+) {
+    let mut sequence = 0u64;
+    for attempt in 1..=MAX_ATTEMPTS {
+        set_status(&status, Status::Starting { attempt });
+        let outcome = match Worker::spawn(&executable, &config) {
+            Err(error) => error.to_string(),
+            Ok(mut worker) => {
+                let outcome = tokio::select! {
+                    _ = &mut stop => { worker.close().await; set_status(&status, Status::Stopped); return; }
+                    result = timeout(Duration::from_secs(10), read_frame(&mut worker.output)) => {
+                        match result {
+                            Ok(Ok(bytes)) => serde_json::from_slice::<Ready>(&bytes).map_err(io::Error::other).and_then(|ready| { ready.verify(&config.identity)?; Ok(ready) }),
+                            Ok(Err(error)) => Err(error),
+                            Err(error) => Err(io::Error::other(error)),
+                        }
+                    }
+                };
+                let reason = match outcome {
+                    Err(error) => error.to_string(),
+                    Ok(ready) => {
+                        set_status(&status, Status::Ready { ready });
+                        loop {
+                            tokio::select! {
+                                _ = &mut stop => { worker.close().await; set_status(&status, Status::Stopped); return; }
+                                exited = worker.child.wait() => { break format!("host exited: {exited:?}"); }
+                                request = requests.recv() => {
+                                    let Some(request) = request else { worker.close().await; set_status(&status, Status::Stopped); return; };
+                                    if Instant::now() >= request.deadline {
+                                        respond(request.message, Err(failure("durable_host_busy", "Request expired before sending")));
+                                        continue;
+                                    }
+                                    sequence += 1;
+                                    let id = sequence.to_string();
+                                    let frame = match encode_request(&id, &request.operation) {
+                                        Ok(frame) => frame,
+                                        Err(error) => {
+                                            respond(request.message, Err(failure("invalid_request", &error.to_string())));
+                                            continue;
+                                        }
+                                    };
+                                    let result = tokio::select! {
+                                        _ = &mut stop => {
+                                            respond(request.message, Err(failure("durable_host_ack_lost", "Host stopped; reconcile by request ID before retrying")));
+                                            worker.close().await; set_status(&status, Status::Stopped); return;
+                                        }
+                                        result = timeout(request.operation.rpc_timeout().min(request.deadline.saturating_duration_since(Instant::now())), worker.exchange(&id, &frame)) => result,
+                                    };
+                                    match result {
+                                        Ok(Ok(response)) => respond(request.message, response),
+                                        error => {
+                                            respond(request.message, Err(failure("durable_host_ack_lost", "Acknowledgement lost; reconcile by request ID before retrying")));
+                                            break format!("host RPC failed: {error:?}");
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                };
+                set_status(
+                    &status,
+                    Status::Unavailable {
+                        attempts: attempt,
+                        reason: reason.clone(),
+                    },
+                );
+                while let Ok(request) = requests.try_recv() {
+                    respond(
+                        request.message,
+                        Err(failure(
+                            "durable_host_unavailable",
+                            "Host exited before sending request",
+                        )),
+                    );
+                }
+                worker.close().await;
+                reason
+            }
+        };
+        tracing::warn!(attempt, reason = %outcome, "durable host unavailable");
+        set_status(
+            &status,
+            Status::Unavailable {
+                attempts: attempt,
+                reason: outcome,
+            },
+        );
+        while let Ok(request) = requests.try_recv() {
+            respond(
+                request.message,
+                Err(failure(
+                    "durable_host_unavailable",
+                    "Host exited before sending request",
+                )),
+            );
+        }
+        if attempt < MAX_ATTEMPTS {
+            tokio::select! {
+                _ = &mut stop => { set_status(&status, Status::Stopped); return; }
+                _ = tokio::time::sleep(Duration::from_millis(250 * u64::from(attempt))) => {}
+            }
+        }
+    }
+}
