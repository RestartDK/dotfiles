 pub(crate) fn separator(previous: &ResolvedToken, current: &ResolvedToken) -> &'static str {
+    let paired_changes = match (&previous.kind, &current.kind) {
+        (ResolvedTokenKind::Custom(added), ResolvedTokenKind::Custom(deleted)) => {
+            added.strip_prefix('+').is_some_and(|value| value.parse::<u64>().is_ok())
+                && deleted.strip_prefix('-').is_some_and(|value| value.parse::<u64>().is_ok())
+        }
+        _ => false,
+    };
     if matches!(previous.kind, ResolvedTokenKind::StateIcon)
         || matches!(current.kind, ResolvedTokenKind::GitStatus { .. })
+        || paired_changes
     {
         " "
     } else {
         " · "
     }
 }
